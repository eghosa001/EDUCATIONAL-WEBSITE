{
  "framework": "nextjs",
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "devCommand": "next dev",
  "env": {
    "NEXT_PUBLIC_API_URL": "/api/v1"
  },
  "rewrites": [
    {
      "source": "/api/v1/:path*",
      "destination": "https://backend-eight-chi-60.vercel.app/api/v1/:path*"
    }
  ]
}
