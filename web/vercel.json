{
  "buildCommand": "npm run build",
  "outputDirectory": ".next",
  "framework": "nextjs",
  "devCommand": "next dev",
  "env": {
    "NEXT_PUBLIC_API_URL": "/api/v1"
  },
  "rewrites": [
    { "source": "/api/v1/(.*)", "destination": "https://backend-eight-chi-60.vercel.app/api/v1/$1" }
  ],
  "headers": [
    {
      "source": "/api/v1/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Credentials", "value": "true" }
      ]
    }
  ]
}
